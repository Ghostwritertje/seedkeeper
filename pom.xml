<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.ghostwritertje</groupId>
    <artifactId>seedkeeper</artifactId>
    <version>0.6.1-SNAPSHOT</version>
    <packaging>quarkus</packaging>

    <properties>
        <antrun-plugin.version>3.2.0</antrun-plugin.version>
        <archunit.version>1.4.1</archunit.version>
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <error-prone.version>2.52.0</error-prone.version>
        <!-- Needs a JaCoCo release that reads Java 25 class files. Dependabot bumps it apart from Quarkus. -->
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <nullaway.version>0.14.3</nullaway.version>
        <!-- A Spotless setting, so Dependabot doesn't track it: bump it by hand, in a pull request (ADR 0003). -->
        <palantir-java-format.version>2.103.0</palantir-java-format.version>
        <!-- PIT mutates the main classes changed since the merge base with this ref. -->
        <pit.base>origin/main</pit.base>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <pitest-plugin.version>1.30.2</pitest-plugin.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus-jdbc-sqlite.version>3.0.11</quarkus-jdbc-sqlite.version>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.40.1.2</quarkus.platform.version>
        <skipITs>true</skipITs>
        <sortpom-plugin.version>4.0.0</sortpom-plugin.version>
        <spotless-plugin.version>3.11.0</spotless-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <versions-plugin.version>2.25.2</versions-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The run history: SQLite in the data dir, migrated by Flyway, read and written with plain JDBC. -->
        <dependency>
            <groupId>io.quarkiverse.jdbc</groupId>
            <artifactId>quarkus-jdbc-sqlite</artifactId>
            <version>${quarkus-jdbc-sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-logging-json</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-csrf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-qute</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!-- @NullMarked and @Nullable, which NullAway reads in the quality build. Annotations only; the Quarkus BOM manages the version. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- Reads overrides.yaml. The YAML parser quarkus-config-yaml already brings, so nothing new in the image. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- The deep-module rules (ModuleRulesTest): plain JUnit tests that read the compiled classes. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-internal</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Formatting. The quality profile checks it; `./mvnw spotless:apply sortpom:sort` applies it.
                  Configured here, outside the profile, so that command works without -Pquality.
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-plugin.version}</version>
                    <configuration>
                        <java>
                            <palantirJavaFormat>
                                <version>${palantir-java-format.version}</version>
                            </palantirJavaFormat>
                        </java>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.ekryd.sortpom</groupId>
                    <artifactId>sortpom-maven-plugin</artifactId>
                    <version>${sortpom-plugin.version}</version>
                    <configuration>
                        <createBackupFile>false</createBackupFile>
                        <expandEmptyElements>false</expandEmptyElements>
                        <keepBlankLines>true</keepBlankLines>
                        <lineSeparator>\n</lineSeparator>
                        <nrOfIndentSpace>4</nrOfIndentSpace>
                        <sortDependencies>scope,groupId,artifactId</sortDependencies>
                        <sortPlugins>groupId,artifactId</sortPlugins>
                        <sortProperties>true</sortProperties>
                        <spaceBeforeCloseEmptyElement>false</spaceBeforeCloseEmptyElement>
                    </configuration>
                </plugin>
                <!-- Used by the release workflow (versions:set); pinned so the build is reproducible. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
                <!--
                  The tests in the `startup` package start the application with a broken configuration
                  (QuarkusExtensionTest). Quarkus can't run those and @QuarkusTest classes in one JVM, so they
                  get a run of their own.
                -->
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludes>
                                <exclude>**/startup/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>startup-tests</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/startup/**/*Test.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          The quality build: `./mvnw verify -Pquality`. Adds the Java quality checks on top of the default
          build, which stays as fast as it is. CI runs it as `Verify (quality)`.
        -->
        <profile>
            <id>quality</id>
            <dependencies>
                <!--
                  Coverage, so @QuarkusTest tests count: Quarkus instruments the classes it loads and writes
                  target/jacoco-quarkus.exec. In the profile only, so the default build stays fast.
                -->
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-jacoco</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- Formatting runs first, at validate: it's the cheapest check and fails before compiling. -->
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-formatting</id>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <phase>validate</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.ekryd.sortpom</groupId>
                        <artifactId>sortpom-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-pom-sorted</id>
                                <goals>
                                    <goal>verify</goal>
                                </goals>
                                <phase>validate</phase>
                                <configuration>
                                    <verifyFail>Stop</verifyFail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                      Finds the main classes this branch changes compared to ${pit.base}, for PIT below.
                      PIT's own SCM goal is gone since PIT 1.18, and the last PIT that has it can't read Java 25
                      classes. Compares the working tree with the merge base, so uncommitted changes count too.
                      Sets pit.targetClasses (each changed class and its nested classes) and pit.noChangedClasses.
                    -->
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${antrun-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>find-changed-classes</id>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <phase>process-test-classes</phase>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <exec dir="${project.basedir}" executable="git" failonerror="true" outputproperty="pit.changedSources">
                                            <arg value="diff"/>
                                            <arg value="--name-only"/>
                                            <arg value="--relative"/>
                                            <arg value="--diff-filter=d"/>
                                            <arg value="--merge-base"/>
                                            <arg value="${pit.base}"/>
                                            <arg value="--"/>
                                            <arg value="src/main/java"/>
                                        </exec>
                                        <loadresource property="pit.targetClasses">
                                            <propertyresource name="pit.changedSources"/>
                                            <filterchain>
                                                <linecontainsregexp>
                                                    <regexp pattern="^src/main/java/.+\.java$"/>
                                                </linecontainsregexp>
                                                <linecontainsregexp negate="true">
                                                    <regexp pattern="(package|module)-info\.java$"/>
                                                </linecontainsregexp>
                                                <tokenfilter delimoutput=",">
                                                    <replaceregex pattern="^src/main/java/(.+)\.java$" replace="\1,\1$*"/>
                                                    <replacestring from="/" to="."/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <condition else="false" property="pit.noChangedClasses" value="true">
                                            <not>
                                                <isset property="pit.targetClasses"/>
                                            </not>
                                        </condition>
                                        <property name="pit.targetClasses" value=""/>
                                        <echo level="info" message="Main classes changed compared to ${pit.base}: ${pit.targetClasses}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                      Error Prone at its default error level, and every compiler warning as an error. Error Prone
                      is a javac plugin, so it runs only here and the default build stays fast. javac runs in a
                      forked process, so the -J flags open the compiler internals Error Prone needs without a
                      .mvn/jvm.config that every build would pick up.
                    -->
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <fork>true</fork>
                            <compilerArgs combine.children="append">
                                <!--
                                  Every lint but two that only report on dependency jars, not on our code:
                                  `path` (cron-utils' manifest Class-Path names an slf4j jar that doesn't exist) and
                                  `classfile` (microprofile-config-api's ConfigProperty carries OSGi annotations
                                  that aren't on the classpath).
                                -->
                                <arg>-Xlint:all,-path,-classfile</arg>
                                <arg>-Werror</arg>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <!--
                                  Generated code is ours neither to judge nor to fix. NullAway is an Error Prone
                                  check at error level; it checks only @NullMarked code (every package, see
                                  NullMarkedPackagesTest), reads JSpecify's annotations, and skips @Generated
                                  classes as well as the excluded paths.
                                -->
                                <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/target/generated-(test-)?sources/.* -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:TreatGeneratedAsUnannotated=true</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${error-prone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${nullaway.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                    <!--
                      quarkus-jacoco adds to the data file the agent writes, instead of starting it over, and
                      leaves the report to the jacoco-maven-plugin below.
                    -->
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <quarkus.jacoco.reuse-data-file>true</quarkus.jacoco.reuse-data-file>
                                <quarkus.jacoco.report>false</quarkus.jacoco.report>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                    <!--
                      Coverage. The agent covers the tests that don't start the app and leaves the classes Quarkus
                      loads to quarkus-jacoco; both write to target/jacoco-quarkus.exec. The build fails below
                      80% line coverage; the report is in target/site/jacoco.
                    -->
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco-plugin.version}</version>
                        <configuration>
                            <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>coverage-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
                                    <append>true</append>
                                    <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                                </configuration>
                            </execution>
                            <execution>
                                <id>coverage-report</id>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                                <phase>verify</phase>
                            </execution>
                            <execution>
                                <id>coverage-floor</id>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <phase>verify</phase>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.80</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                      Mutation testing of the changed main classes, with the tests that don't start the app:
                      src/test/pit registers SkipTestsThatStartTheApp with the JUnit Platform for PIT alone.
                      The threshold is test strength, the score over the mutants those tests reach, so code that only
                      the app-starting tests cover doesn't fail the build (JaCoCo covers that).
                    -->
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-plugin.version}</version>
                        <configuration>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.basedir}/src/test/pit</additionalClasspathElement>
                            </additionalClasspathElements>
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <parseSurefireArgLine>false</parseSurefireArgLine>
                            <skip>${pit.noChangedClasses}</skip>
                            <targetClasses>${pit.targetClasses}</targetClasses>
                            <testStrengthThreshold>80</testStrengthThreshold>
                            <threads>4</threads>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>mutation-test-changed-classes</id>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                                <phase>verify</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.native.builder-image>quay.io/quarkus/ubi9-quarkus-mandrel-builder-image:jdk-25</quarkus.native.builder-image>
                <!--
                  Built inside the Mandrel builder container (the builder image above), so the binary is linked
                  against the same glibc (UBI 9) as the runtime image in src/main/docker/Dockerfile.native-micro.
                  Keep the two on the same UBI major.
                -->
                <quarkus.native.container-build>true</quarkus.native.container-build>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
            </properties>
        </profile>
    </profiles>
</project>
