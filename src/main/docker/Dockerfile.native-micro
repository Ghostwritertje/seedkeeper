####
# Runs the seedkeeper native executable (no JVM) on the Quarkus micro base image.
# See https://quarkus.io/guides/quarkus-runtime-base-image for the base image.
#
# Build the executable first (in the Mandrel builder container, see the `native` profile in pom.xml):
#
#   ./mvnw package -Dnative
#
# Then build and run the image:
#
#   docker build -f src/main/docker/Dockerfile.native-micro -t seedkeeper .
#   docker run --rm -p 8080:8080 seedkeeper
#
# `quay.io/quarkus/quarkus-micro-image:2.0` is based on UBI 8. The builder image in pom.xml
# (`ubi-quarkus-mandrel-builder-image`) is UBI 8 too; keep both on the same UBI major, or the
# executable is linked against a newer glibc than the image has.
#
# The image must work as any non-root uid:gid (`docker run --user 1029:65536`): the executable is
# world-readable and world-executable, and the application writes nothing under /work.
###
FROM quay.io/quarkus/quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
